# Copy to .env and edit. .env is git-ignored.

# Host port the routing nginx binds on 127.0.0.1 (the host nginx proxies to it).
PORT=8081

# First-start admin. Used only when the user table is empty; the account must change
# the password at first login. Remove ROOT_PASSWORD from this file afterwards.
ROOT_USERNAME=root
ROOT_PASSWORD=

# Host directory for uploads (bind mount). Must be writable by LFU_UID:LFU_GID:
#   sudo mkdir -p data/uploads && sudo chown 10001:10001 data/uploads
UPLOAD_HOST_DIR=./data/uploads
LFU_UID=10001
LFU_GID=10001
# Group that should be able to read finished files on the host (files are 0640, dirs 0750).
FILE_GID=10001

# Files must be strictly smaller than this many bytes (100 GiB).
MAX_UPLOAD_BYTES=107374182400
# Browser chunk size in MiB (1-60). Each chunk is one request and is buffered once on the server.
CHUNK_SIZE_MIB=32
# Keep at least this much disk free beyond the declared size of every upload (10 GiB).
RESERVE_BYTES=10737418240
# Abandoned partial uploads are removed after this many days. Completed files are never deleted.
PARTIAL_EXPIRY_DAYS=7
SESSION_IDLE_HOURS=24
# How many files the server re-hashes at once (disk I/O bound).
VERIFY_WORKERS=1
